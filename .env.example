# AI client configuration
# Set to true to use stub AI responses (no API key needed, for dev/testing)
GATEWAY_AI_USE_STUB=false

# OpenAI-compatible API base URL (code appends /chat/completions)
# SiliconFlow: https://api.siliconflow.cn/v1
# OpenAI: https://api.openai.com/v1
GATEWAY_AI_BASE_URL=https://api.siliconflow.cn/v1

# Model name (must be supported by your API provider)
# SiliconFlow examples: deepseek-ai/DeepSeek-V4-Flash, Qwen/Qwen2.5-7B-Instruct
# OpenAI examples: gpt-3.5-turbo, gpt-4, gpt-4-turbo
GATEWAY_AI_MODEL=deepseek-ai/DeepSeek-V4-Flash

# API key for authentication
GATEWAY_AI_API_KEY=your-api-key-here

# Optional: Gateway token for frontend authentication
# GATEWAY_TOKEN=your-gateway-token
